<.header>
  {@page_title}
  <:actions>
    <%= if @live_action == :index do %>
      <.link navigate={~p"/clubs/#{@club}/contacts/new_short"}>
        <.button>Kontaktschnellerfassung</.button>
      </.link>
      <.link navigate={~p"/clubs/#{@club}/contacts/new"}>
        <.button>Kontakt erstellen</.button>
      </.link>
    <% end %>
    <%= if @live_action == :index_member do %>
      <.link href={~p"/clubs/#{@club}/members/inventory_list/#{@member_inventory_year}"} download>
        <.button>Bestandsmeldung</.button>
      </.link>
      <%!-- <.simple_input type="number" name="member_inventory_year" value={@member_inventory_year} class="w-12" /> --%>
      <.link navigate={~p"/clubs/#{@club}/contracts/new_membership"}>
        <.button>Mitgliedsantrag erfassen</.button>
      </.link>
      <.link navigate={~p"/clubs/#{@club}/contracts/new"}>
        <.button>Vereinsmitglied erstellen</.button>
      </.link>
      <.link navigate={~p"/clubs/#{@club}/contacts/new"}>
        <.button>Kontakt erstellen</.button>
      </.link>
    <% end %>
  </:actions>
</.header>

<.card>
  <details>
    <summary>
      Filter
    </summary>
    <search>
      <.form :let={f} for={%{}} as={:search} phx-change="search">
        <.input_grids>
          <.input_grid>
            <div class="col-span-12 md:col-span-6 ml-10">
              <.input field={f[:name]} type="search" label="Name" phx-debounce="1000" />
            </div>
            <div class="col-span-12 md:col-span-3">
              <.input
                field={f[:type]}
                type="select"
                label="Art"
                options={Contact.get_valid_types()}
                prompt="Alle"
                phx-debounce="1000"
              />
            </div>
            <div class="col-span-12 md:col-span-3">
              <.input
                field={f[:role]}
                type="select"
                label="Rolle"
                options={ContactRole.get_valid_names()}
                prompt="Alle"
                phx-debounce="1000"
              />
            </div>
            <div class="col-span-12 md:col-span-3 ml-10">
              <.button type="reset">Filter zurücksetzen</.button>
            </div>
          </.input_grid>
        </.input_grids>
      </.form>
    </search>
  </details>
</.card>
<.card class="mt-5">
  <p>Gesamt: {@contacts_total} davon werden aktuell angezeigt: {@contacts_shown}</p>
</.card>
<.card class="mt-5">
  <%= if Enum.any?(@streams.contacts.inserts) do %>
    <.contact_table streams={@streams} live_action={@live_action} club={@club} type={@type} />
  <% else %>
    <%= if @contacts_present do %>
      <p>
        Es wurden keine Kontakte gefunden, die zu den Filterkriterien passen.
      </p>
    <% else %>
      <p>
        Bisher wurde noch kein Kontakt erstellt.
      </p>
    <% end %>
  <% end %>
</.card>

<div :if={@live_action == :index_member} class="mt-4 flex align-middle">
  <.icon name="hero-check-badge" class="mr-1 inline-block w-[20px] text-green-800" /> Mitglied
</div>
